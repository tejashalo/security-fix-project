# All optional.
PORT=3000
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy (Render, Railway, Fly, Nginx) so rate limits use the real client IP.
TRUST_PROXY=0
MAX_UPLOAD_MB=50
JOB_TTL_MINUTES=30
MAX_CONCURRENT_SCANS=2
SCAN_RATE_LIMIT=20
RATE_LIMIT_MAX=600
# Override registries (e.g. a corporate mirror)
VIBEGUARD_NPM_REGISTRY=https://registry.npmjs.org
VIBEGUARD_PYPI=https://pypi.org
MAX_QUEUED_SCANS=20
# Where uploads are unpacked (defaults to the OS temp folder)
VIBEGUARD_TMP=
# Print internal errors to the console
VIBEGUARD_DEBUG=
